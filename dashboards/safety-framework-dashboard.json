          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  r.risk_level,\n  d.decision,\n  COUNT(*) as count\nFROM incident_risk_assessment r\nJOIN autonomous_decision_log d ON r.incident_number = d.incident_number\nWHERE r.assessed_at >= NOW() - INTERVAL '$__range_s seconds'\nGROUP BY r.risk_level, d.decision\nORDER BY \n  CASE r.risk_level\n    WHEN 'CRITICAL' THEN 1\n    WHEN 'HIGH' THEN 2\n    WHEN 'MEDIUM' THEN 3\n    WHEN 'LOW' THEN 4\n  END;",
          "refId": "A"
        }
      ],
