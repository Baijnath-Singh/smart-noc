          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  i.incident_number,\n  i.primary_device,\n  i.incident_type,\n  r.risk_level,\n  ROUND(r.overall_risk_score::numeric, 3) as risk_score,\n  ROUND(d.calibrated_confidence::numeric, 3) as confidence,\n  d.decision,\n  d.reasoning,\n  d.decided_at\nFROM incidents i\nJOIN incident_risk_assessment r ON i.incident_number = r.incident_number\nJOIN autonomous_decision_log d ON i.incident_number = d.incident_number\nWHERE d.decided_at >= NOW() - INTERVAL '$__range_s seconds'\nORDER BY d.decided_at DESC\nLIMIT 100;",
          "refId": "A"
        }
      ],
