# Phase 4 LLM Diagnosis Service - Environment Configuration

# LLM Provider (openai, anthropic, azure)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_API_KEY=your-api-key-here

# Optional: Azure OpenAI
# LLM_API_BASE=https://your-resource.openai.azure.com/

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INPUT_TOPIC=incidents
KAFKA_OUTPUT_TOPIC=incidents-diagnosed
KAFKA_CONSUMER_GROUP=llm-diagnosis-service
KAFKA_AUTO_OFFSET_RESET=latest

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_noc
POSTGRES_USER=noc_admin
POSTGRES_PASSWORD=noc_password

# Diagnosis Configuration
DIAGNOSIS_MIN_CONFIDENCE=0.3
DIAGNOSIS_DELAY_SECONDS=5
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_DIAGNOSIS=true
ENABLE_REMEDIATION=true
ENABLE_CACHE=true
ENABLE_COST_TRACKING=true
